{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/demo/questlab/*", "/*.{css,scss,js,png,jpg,jpeg,gif,ico,svg,woff,woff2,ttf,eot}"]
  },
  "routes": [
    {
      "route": "/demo/questlab",
      "serve": "/demo/questlab/index.html",
      "statusCode": 200
    },
    {
      "route": "/demo/questlab/*",
      "serve": "/demo/questlab/index.html",
      "statusCode": 200
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
